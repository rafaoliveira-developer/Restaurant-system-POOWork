<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml/1" styleClass="account-card" alignment="CENTER_LEFT" spacing="15">
  <VBox spacing="5" HBox.hgrow="ALWAYS">
    <Label fx:id="tableName" styleClass="account-title"/>
    <Label fx:id="tabName" styleClass="muted"/>
    <Label fx:id="time" styleClass="muted"/>
  </VBox>
  <VBox alignment="CENTER_RIGHT" spacing="10">
    <Label fx:id="total" styleClass="account-title"/>
    <Button fx:id="open" text="Abrir comanda" styleClass="primary"/>
  </VBox>
</HBox>