<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/central.css">
  <left><VBox fx:id="sidebar" minWidth="240" prefWidth="240" maxWidth="240" spacing="12" styleClass="sidebar">
    <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
    <HBox alignment="CENTER_LEFT" prefHeight="57" spacing="6">
      <ImageView fx:id="logo" fitWidth="150" preserveRatio="true"/>
      <Region HBox.hgrow="ALWAYS"/><Button fx:id="toggle" accessibleText="Alternar menu lateral" styleClass="icon-button"/>
    </HBox>
    <VBox fx:id="links" spacing="6"/><Region VBox.vgrow="ALWAYS"/>
    <Separator/><VBox fx:id="bottomLinks" spacing="6"/>
  </VBox></left>
  <center><BorderPane>
    <top><HBox styleClass="top-bar" prefHeight="72" alignment="CENTER_LEFT" spacing="14">
      <Region HBox.hgrow="ALWAYS"/><Label fx:id="connection" styleClass="muted"/><Label fx:id="badge" styleClass="badge"/>
      <VBox alignment="CENTER_LEFT"><Label fx:id="user" styleClass="person"/><Label fx:id="role" styleClass="muted"/></VBox>
      <Button fx:id="logout" styleClass="icon-button" accessibleText="Sair"/>
    </HBox></top><center><StackPane fx:id="content"/></center>
  </BorderPane></center>
</BorderPane>