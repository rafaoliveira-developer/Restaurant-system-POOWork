<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:padding="18dp" android:background="#F5F7FA">
 <TextView android:id="@+id/revisaoTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:text="Revisar pedido" android:textSize="24sp" android:textColor="#15253A"/>
<ScrollView android:layout_width="match_parent" android:layout_height="255dp"><LinearLayout android:id="@+id/revisaoItens" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
<TextView android:id="@+id/revisaoTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:text="Total estimado" android:textSize="18sp" android:textColor="#15253A"/><Button android:id="@+id/revisaoEnviar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="PEDIR" android:textAllCaps="false"/>
</LinearLayout>
