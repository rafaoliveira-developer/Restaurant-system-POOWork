<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/tituloComanda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mesa"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/statusComanda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nenhuma comanda aberta"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tituloComanda"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/totalComanda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total previsto: R$ 0,00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusComanda"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tituloItens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Itens da comanda"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/totalComanda"
        app:layout_constraintStart_toStartOf="parent" />


    <ScrollView
        android:id="@+id/rolagemItens"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tituloItens"
        app:layout_constraintBottom_toTopOf="@id/botaoAbrirComanda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/listaItensComanda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mensagemListaVazia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum item registrado."
                android:textSize="15sp"
                android:padding="8dp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/botaoAbrirComanda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Abrir comanda"
        app:layout_constraintBottom_toTopOf="@id/botaoCardapio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/botaoCardapio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ver cardápio"
        app:layout_constraintBottom_toTopOf="@id/botaoPagamento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/botaoPagamento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ir para pagamento"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
