<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tituloAdministracao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Área administrativa"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/subtituloAdministracao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerenciamento do restaurante"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tituloAdministracao"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tituloCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastrar produto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/subtituloAdministracao"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/campoNomeProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nome do produto"
            android:inputType="textCapSentences"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tituloCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/campoPrecoProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Preço"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/campoNomeProduto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinnerSetor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/campoPrecoProduto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/botaoAdicionarProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Adicionar produto"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerSetor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tituloListaProdutos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Produtos cadastrados"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/botaoAdicionarProduto"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/listaAdministracao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tituloListaProdutos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/botaoVoltar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Voltar às mesas"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/listaAdministracao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
